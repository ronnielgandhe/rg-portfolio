---
import { AstroSeo } from '@astrolib/seo';
import StoryPage from '../components/portfolio/StoryPage';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <meta name="author" content="Ronniel Gandhe" />

    <AstroSeo
      title="harvey, a lawyer that picks up | Ronniel Gandhe"
      description="harvey, a lawyer that picks up. ronniel gandhe, software engineer in san francisco."
      canonical="https://ronnielgandhe.com/harvey"
      openGraph={{
        url: 'https://ronnielgandhe.com/harvey',
        title: 'harvey, a lawyer that picks up | Ronniel Gandhe',
        description: 'harvey, a lawyer that picks up. ronniel gandhe, software engineer in san francisco.',
        site_name: 'Ronniel Gandhe',
      }}
    />

    <link rel="icon" type="image/png" href="/icons/baseheadlogo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/baseheadlogo.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&display=swap" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: #ffffff;
        overflow-x: clip;
        max-width: 100vw;
        min-height: 100vh;
      }

      body {
        margin: 0;
        min-width: 320px;
        background: transparent;
        overflow-x: clip;
        min-height: 100vh;
        width: 100%;
      }

      ::-webkit-scrollbar {
        width: 0px;
        background: transparent;
      }

      canvas {
        display: block !important;
        max-width: 100% !important;
        max-height: 100% !important;
      }

      a {
        color: inherit;
        text-decoration: inherit;
      }
    </style>
  </head>
  <body>
    <StoryPage slug="harvey" client:only="react" />
  </body>
</html>
