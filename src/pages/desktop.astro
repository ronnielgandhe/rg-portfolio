---
import { AstroSeo } from '@astrolib/seo';
import DesktopShell from '../components/desktop/DesktopShell';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <meta name="author" content="Ronniel Gandhe" />

    <AstroSeo
      title="Ronniel OS — Interactive Desktop"
      description="An interactive macOS-themed desktop environment showcasing Ronniel Gandhe's portfolio"
      canonical="https://ronnielgandhe.com/desktop"
      openGraph={{
        url: 'https://ronnielgandhe.com/desktop',
        title: 'Ronniel OS — Interactive Desktop',
        description: 'An interactive macOS-themed desktop environment showcasing Ronniel Gandhe\'s portfolio',
        site_name: 'Ronniel Gandhe',
      }}
    />

    <link rel="icon" type="image/png" href="/icons/baseheadlogo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/baseheadlogo.png" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        if (e.viewTransition) document.documentElement.classList.add('rg-vt-in');
      });
    </script>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: #ffffff;
        overflow-x: hidden;
        max-width: 100vw;
        min-height: 100vh;
      }

      body {
        margin: 0;
        display: flex;
        place-items: center;
        min-width: 320px;
        background: #ffffff;
        overflow-x: hidden;
        min-height: 100vh;
      }

      ::-webkit-scrollbar {
        width: 0px;
        background: transparent;
      }

      canvas {
        display: block !important;
        max-width: 100% !important;
        max-height: 100% !important;
      }

      a {
        color: #646cff;
        text-decoration: inherit;
      }
      a:hover {
        color: #535bf2;
      }

      .rg-desktop {
        position: fixed;
        inset: 0;
        background: #ffffff;
        view-transition-name: rg-desktop;
      }

      .rg-back:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
      }

      @media (prefers-reduced-motion: no-preference) {
        @view-transition { navigation: auto; }

        ::view-transition-group(root) { animation-duration: 280ms; }
        ::view-transition-image-pair(root) { isolation: auto; }
        ::view-transition-old(root) { animation: none; mix-blend-mode: normal; }
        ::view-transition-new(root) { animation: 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both rg-fade-in; mix-blend-mode: normal; }

        ::view-transition-group(rg-desktop) {
          animation-duration: 500ms;
          animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
          overflow: clip;
        }
        ::view-transition-image-pair(rg-desktop) { isolation: auto; }
        ::view-transition-old(rg-desktop),
        ::view-transition-new(rg-desktop) {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: top center;
          mix-blend-mode: normal;
        }
        ::view-transition-old(rg-desktop) { animation: 220ms ease 300ms both rg-fade-out; }
        ::view-transition-new(rg-desktop) { animation: 300ms ease 220ms both rg-fade-in; }
        ::view-transition-new(rg-desktop):only-child { animation: 300ms cubic-bezier(0.16, 1, 0.3, 1) both rg-scale-in; }

        .rg-desk { animation: 300ms cubic-bezier(0.16, 1, 0.3, 1) backwards rg-scale-in; }
        .rg-vt-in .rg-desk { animation: 300ms ease backwards rg-fade-in; }
        .desktop-menu-bar { animation: 380ms cubic-bezier(0.16, 1, 0.3, 1) 140ms backwards rg-bar-in; }
        .desktop-dock { animation: 420ms cubic-bezier(0.16, 1, 0.3, 1) 180ms backwards rg-dock-in; }
      }

      @keyframes rg-fade-in { from { opacity: 0; } }
      @keyframes rg-fade-out { to { opacity: 0; } }
      @keyframes rg-scale-in { from { opacity: 0; transform: scale(0.96); } }
      @keyframes rg-bar-in { from { opacity: 0; translate: 0 -100%; } }
      @keyframes rg-dock-in { from { opacity: 0; translate: 0 28px; } }
    </style>
  </head>
  <body>
    <div class="rg-desktop">
      <DesktopShell client:only="react" />
    </div>
  </body>
</html>
