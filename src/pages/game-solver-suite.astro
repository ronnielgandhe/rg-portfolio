---
import { AstroSeo } from '@astrolib/seo';
import SolverPage from '../components/portfolio/SolverPage';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Ronniel Gandhe" />

    <AstroSeo
      title="game solver suite | Ronniel Gandhe"
      description="game solver suite. ronniel gandhe, software engineer in san francisco."
      canonical="https://ronnielgandhe.com/game-solver-suite"
      openGraph={{
        url: 'https://ronnielgandhe.com/game-solver-suite',
        title: 'game solver suite | Ronniel Gandhe',
        description: 'game solver suite. ronniel gandhe, software engineer in san francisco.',
        site_name: 'Ronniel Gandhe',
      }}
    />

    <link rel="icon" type="image/png" href="/icons/baseheadlogo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/baseheadlogo.png" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>try{if(localStorage.getItem('rg-theme')==='dark'){document.documentElement.style.backgroundColor='#0e0e0e';document.querySelector('meta[name=theme-color]').content='#0e0e0e'}}catch(e){}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600&display=swap" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: #ffffff;
        overflow-x: clip;
        max-width: 100vw;
        min-height: 100vh;
      }

      body {
        margin: 0;
        min-width: 320px;
        background: transparent;
        overflow-x: clip;
        min-height: 100vh;
        width: 100%;
      }


      canvas {
        display: block !important;
        max-width: 100% !important;
        max-height: 100% !important;
      }

      a {
        color: inherit;
        text-decoration: inherit;
      }
    </style>
  </head>
  <body>
    <SolverPage client:only="react" />
  </body>
</html>
